# --- Database (used by web, bot, and db package) ---
DATABASE_URL="postgresql://ultimahost:ultimahost@localhost:5432/ultimahost?schema=public"

# --- Telegram bot ---
# Get a token from @BotFather
BOT_TOKEN=""
# Telegram chat/user id that receives "payment received" notifications and can confirm/reject orders.
# For a personal chat this is your numeric Telegram user id; for a group, the group's chat id.
ADMIN_CHAT_ID=""
SUPPORT_USERNAME="ultimahost_support"

# --- Hetzner Cloud ---
# Create a Project -> Security -> API Tokens (read+write) at https://console.hetzner.cloud
# Leave empty to run in demo mode: orders still flow end-to-end with a simulated server.
HETZNER_API_TOKEN=""
# Optional: numeric ID of an SSH key already uploaded to your Hetzner project, to skip root-password auth.
HETZNER_SSH_KEY_ID=""

# --- Payments ---
# One of: manual | yookassa | cryptobot
PAYMENT_PROVIDER="manual"
MANUAL_PAYMENT_INSTRUCTIONS="Переведите сумму заказа на карту 0000 0000 0000 0000, затем нажмите «Я оплатил»."

YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
PAYMENT_RETURN_URL="https://ultimahost.example/tariffs"

CRYPTOBOT_TOKEN=""

# --- Web app ---
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/ultimahost_bot"
