# --- Database (used by web, bot, and db package) ---
DATABASE_URL="postgresql://ultimahost:ultimahost@localhost:5432/ultimahost?schema=public"

# --- Telegram bot ---
# Get a token from @BotFather
BOT_TOKEN=""
# Telegram chat/user id that receives "payment received" notifications and can confirm/reject orders.
# For a personal chat this is your numeric Telegram user id; for a group, the group's chat id.
ADMIN_CHAT_ID=""
SUPPORT_USERNAME="ultimahost_support"

# --- Hetzner Cloud ---
# Create a Project -> Security -> API Tokens (read+write) at https://console.hetzner.cloud
# Leave empty to run in demo mode: orders still flow end-to-end with a simulated server.
HETZNER_API_TOKEN=""
# Optional: numeric ID of an SSH key already uploaded to your Hetzner project, to skip root-password auth.
HETZNER_SSH_KEY_ID=""

# --- Pricing (себестоимость Hetzner -> цена продажи) ---
# Формула: priceRub = costEur * (курс_EUR/RUB * 1.05) * 1.30
# costEur задаётся по тарифу в packages/db/prisma/seed.ts, курс обновляется
# автоматически (см. pnpm price:refresh / apps/bot автозапуск).
# Источник курса по умолчанию — ЦБ РФ (cbr-xml-daily.ru), можно заменить на биржевой.
EXCHANGE_RATE_SOURCE_URL="https://www.cbr-xml-daily.ru/daily_json.js"

# --- Payments ---
# Основной провайдер — Platega (карты, СБП, криптовалюта). Если не задан —
# для способа "crypto" используется CryptoBot (если задан), иначе — ручная
# оплата по реквизитам с подтверждением админом в боте.
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET=""
PLATEGA_BASE_URL="https://api.platega.io"
PAYMENT_RETURN_URL="https://ultimahost.example/tariffs"

MANUAL_PAYMENT_INSTRUCTIONS="Переведите сумму заказа на карту 0000 0000 0000 0000, затем нажмите «Я оплатил»."

# Альтернативный крипто-провайдер (Telegram @CryptoBot), используется только
# если Platega не настроена.
CRYPTOBOT_TOKEN=""

# Необязательный альтернативный провайдер для карт (не подключён по умолчанию).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# --- Web app ---
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/ultimahost_bot"
