# ============================================================
# VDS Reseller Bot — environment configuration
# Скопируйте в .env и заполните значения. НИКОГДА не коммитьте .env!
# ============================================================

# --- Telegram ---
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vds_reseller
POSTGRES_USER=vds
POSTGRES_PASSWORD=change-me-strong-password

# --- Providers ---
# https://my.vultr.com/settings/#settingsapi
VULTR_API_KEY=
# https://console.hetzner.cloud -> Project -> Security -> API Tokens (Read & Write)
HETZNER_API_TOKEN=

# --- Pricing ---
# Наценка в процентах поверх цены провайдера
MARKUP_PERCENT=35
# Курс EUR -> USD для нормализации цен Hetzner (внутренняя валюта — USD)
EUR_USD_RATE=1.08
# Скидки за период, проценты (JSON: месяцы -> скидка)
PERIOD_DISCOUNTS={"1": 0, "3": 3, "6": 5, "12": 10}

# --- Security ---
# Fernet key для шифрования паролей серверов: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Секрет для подписи сессий веб-админки
WEB_SECRET_KEY=change-me-random-64-chars
# Пароль входа в веб-админку
WEB_ADMIN_PASSWORD=change-me

# --- Web admin ---
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Reseller master SSH key (аварийный доступ к серверам клиентов) ---
MASTER_SSH_PUBLIC_KEY=

# --- Referral program ---
# Бонус рефереру с первой покупки реферала, процент
REFERRAL_BONUS_PERCENT=10

# --- Misc ---
LOG_LEVEL=INFO
TZ=Europe/Moscow
