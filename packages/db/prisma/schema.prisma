generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROVISIONING
  ACTIVE
  FAILED
  CANCELLED
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt?  @unique
  username   String?
  firstName  String?
  email      String?  @unique
  createdAt  DateTime @default(now())

  orders Order[]
}

model Plan {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  name              String
  cpu               Int
  ramGb             Int
  diskGb            Int
  /// Себестоимость Hetzner (EUR/мес) — фактическая цена server_type в консоли Hetzner.
  costEur           Float
  /// Цена продажи в рублях — считается из costEur по формуле (курс ЦБ * 1.05) * 1.30
  /// и кэшируется здесь через refreshExchangeRateAndPrices(), чтобы не дёргать
  /// внешний API курса на каждый показ тарифа.
  priceRub          Int
  locationLabel     String
  hetznerServerType String
  hetznerLocation   String
  hetznerImage      String   @default("ubuntu-22.04")
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  orders Order[]
}

/// Кэш последнего известного биржевого курса для пересчёта цен тарифов.
model ExchangeRate {
  id        Int      @id @default(autoincrement())
  base      String
  quote     String
  rate      Float
  updatedAt DateTime @updatedAt

  @@unique([base, quote], name: "base_quote")
}

model Order {
  id              Int         @id @default(autoincrement())
  user            User        @relation(fields: [userId], references: [id])
  userId          Int
  plan            Plan        @relation(fields: [planId], references: [id])
  planId          Int
  status          OrderStatus @default(PENDING_PAYMENT)
  amountRub       Int
  paymentProvider String?
  paymentId       String?
  failureReason   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  server Server?
}

model Server {
  id              Int      @id @default(autoincrement())
  order           Order    @relation(fields: [orderId], references: [id])
  orderId         Int      @unique
  hetznerServerId String?
  ipv4            String?
  ipv6            String?
  rootPassword    String?
  status          String   @default("creating")
  createdAt       DateTime @default(now())
}
